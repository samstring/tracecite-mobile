# Perfetto 模板：渲染帧率 / 卡顿（frame / jank）
duration_ms: 0
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "surfaceflinger"
      atrace_categories: "hwuiTask"
      atrace_apps: "*"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 0
  }
}
